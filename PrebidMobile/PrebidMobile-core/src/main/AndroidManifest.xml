<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The Next-Gen GMA SDK (used by api/multiloadernextgen) declares minSdk 24, and its
         transitive dependency cohort (cronet, webkit, UMP, upgraded play-services) declares
         minSdk 23. Core keeps its lower minSdk, so override the merge to keep supporting the
         lower API for the rest of the library. The multiloadernextgen loaders are only usable
         on API 24+. -->
    <uses-sdk tools:overrideLibrary="com.google.android.libraries.ads.mobile.sdk, com.google.net.cronet.okhttptransport, androidx.webkit, com.google.android.ads.consent, com.google.android.gms.ads, com.google.android.gms.ads.impl, com.google.android.gms.common, org.chromium.net.cronet_api, org.chromium.net.cronet_common, org.chromium.net.cronet_fallback, org.chromium.net.cronet_shared, org.chromium.net.httpengine_native_provider" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android P changes -->
    <application>
        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />
        <activity
                android:exported="true"
                android:name="org.prebid.mobile.rendering.views.browser.AdBrowserActivity"
                android:configChanges="orientation|screenSize|keyboardHidden"
                android:theme="@android:style/Theme.Translucent.NoTitleBar"
                android:windowSoftInputMode="adjustPan|stateHidden"
                android:launchMode="singleTop" />
    </application>

</manifest>