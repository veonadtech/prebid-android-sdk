<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The Next-Gen GMA SDK (used by api/multiloadernextgen) declares minSdk 24; core keeps
         minSdk 23. Override the merge so the rest of core still supports API 23. The
         multiloadernextgen loaders are only usable on API 24+. -->
    <uses-sdk tools:overrideLibrary="com.google.android.libraries.ads.mobile.sdk" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android P changes -->
    <application>
        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />
        <activity
                android:exported="true"
                android:name="org.prebid.mobile.rendering.views.browser.AdBrowserActivity"
                android:configChanges="orientation|screenSize|keyboardHidden"
                android:theme="@android:style/Theme.Translucent.NoTitleBar"
                android:windowSoftInputMode="adjustPan|stateHidden"
                android:launchMode="singleTop" />
    </application>

</manifest>